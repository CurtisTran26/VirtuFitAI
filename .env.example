# ==============================================================================
# APPLICATION GENERAL CONFIGURATION
# ==============================================================================
# Môi trường chạy: development | staging | production
APP_ENV=development

# Tên ứng dụng
APP_NAME="VirtuFit AI Backend"

# Cổng lắng nghe của API trong container/máy host
APP_PORT=8000

# Host binding (0.0.0.0 cho phép Docker map port ra bên ngoài)
APP_HOST=0.0.0.0

# Bật/tắt chế độ debug và reload code khi dev (True/False)
APP_DEBUG=true

# Phiên bản API hiện tại
APP_VERSION=1.0.0

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Địa chỉ host database (dùng tên service 'postgres' nếu chạy qua docker-compose)
DB_HOST=postgres

# Cổng mặc định của PostgreSQL
DB_PORT=5432

# Tên database chính của dự án
DB_NAME=virtufit_db

# Tài khoản quản trị database
DB_USER=virtufit_user

# Mật khẩu database (Cần đổi sang mật khẩu mạnh ở môi trường production)
DB_PASSWORD=virtufit_secure_password_dev

# Kích thước connection pool (tối đa kết nối đồng thời giữ trong pool)
DB_POOL_SIZE=10

# Số kết nối vượt ngưỡng tối đa cho phép tạm thời
DB_MAX_OVERFLOW=20

# Chuỗi kết nối đầy đủ (Database URL theo chuẩn SQLAlchemy/asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://virtufit_user:virtufit_secure_password_dev@postgres:5432/virtufit_db

# ==============================================================================
# CACHE & IN-MEMORY STORE (Redis)
# ==============================================================================
# Địa chỉ host Redis (dùng tên service 'redis' nếu chạy qua docker-compose)
REDIS_HOST=redis

# Cổng Redis tiêu chuẩn
REDIS_PORT=6379

# Mật khẩu xác thực Redis (nếu có cấu hình REQUIREPASS)
REDIS_PASSWORD=

# Số thứ tự DB trong Redis (0-15)
REDIS_DB=0

# URL kết nối Redis đầy đủ
# Format: redis://[:password]@<host>:<port>/<db_number>
REDIS_URL=redis://redis:6379/0

# Thời gian sống mặc định của cache tính bằng giây (ví dụ: 3600 = 1 giờ)
REDIS_DEFAULT_TTL_SECONDS=3600

# ==============================================================================
# AUTHENTICATION & JWT SECURITY
# ==============================================================================
# Khóa bí mật ký JWT token (Tạo bằng lệnh: openssl rand -hex 32)
JWT_SECRET_KEY=e4d2938a9e71b29a8d46e017688bc83f089e5a8bc3bdf1d0725a3a78bf29e712

# Thuật toán mã hóa JWT
JWT_ALGORITHM=HS256

# Thời gian hết hạn của Access Token (phút)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Thời gian hết hạn của Refresh Token (ngày)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# SECURITY & CORS POLICIES
# ==============================================================================
# Danh sách origins được phép gọi API (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Bật/tắt cho phép gửi cookie xác thực qua CORS
CORS_ALLOW_CREDENTIALS=true

# ==============================================================================
# CLOUD OBJECT STORAGE CONFIGURATION (MinIO / AWS S3)
# ==============================================================================
# Endpoint nội bộ container gọi sang MinIO (http://minio:9000) hoặc AWS S3 (https://s3.amazonaws.com)
STORAGE_ENDPOINT=http://minio:9000

# Endpoint công khai cho trình duyệt / mobile client tải ảnh (http://localhost:9000 khi dev)
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Region (dùng 'us-east-1' cho MinIO)
STORAGE_REGION=us-east-1

# Access Key / Root User
STORAGE_ACCESS_KEY=minioadmin

# Secret Key / Root Password
STORAGE_SECRET_KEY=minioadmin

# Bucket công khai (cho ảnh sản phẩm, banner, QR code, avatar công khai)
STORAGE_PUBLIC_BUCKET=virtufit-public

# Bucket riêng tư (cho ảnh người dùng thử đồ, kết quả AI try-on, thiết kế custom)
STORAGE_PRIVATE_BUCKET=virtufit-private

# Thời hạn sống của Presigned URL tải ảnh riêng tư (tính bằng giây, 1800s = 30 phút)
STORAGE_PRESIGNED_EXPIRATION_SECONDS=1800

# Giới hạn dung lượng tải ảnh lên tối đa (tính bằng bytes, 5MB = 5 * 1024 * 1024 = 5242880)
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# ==============================================================================
# PHONE OTP & SMS GATEWAY CONFIGURATION
# ==============================================================================
# Nhà cung cấp SMS: 'mock' (in mã ra Console khi dev) | 'twilio' | 'speedsms'
SMS_PROVIDER=mock

# Thời gian sống của mã OTP (giây, 300s = 5 phút)
OTP_TTL_SECONDS=300

# Thời gian chờ giữa 2 lần gửi mã OTP chống spam (giây, 60s)
OTP_COOLDOWN_SECONDS=60

# Số lần nhập sai mã OTP tối đa trước khi khóa (mặc định 3 lần)
OTP_MAX_ATTEMPTS=3

# Cấu hình Twilio (Tùy chọn khi dùng SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cấu hình SpeedSMS (Tùy chọn khi dùng SMS_PROVIDER=speedsms cho đầu số Việt Nam)
SPEEDSMS_ACCESS_TOKEN=

# ==============================================================================
# GOOGLE OAUTH2 AUTHENTICATION CONFIGURATION
# ==============================================================================
# Client ID nhận được từ Google Cloud Console (APIs & Services -> Credentials)
# Có thể để trống khi dev để sử dụng Mock Google Token tiện lợi
GOOGLE_CLIENT_ID=

# Client Secret (Tùy chọn)
GOOGLE_CLIENT_SECRET=



